# Handoff settings. Copy to .env (or just run `npm run setup`, which creates it for you).
# .env is git-ignored: it holds your password hash and tokens, so never commit or share it.
# Real environment variables override anything in this file.
# 'single quotes' keep a value exactly as written (needed for the password hash).

# ---------------------------------------------------------------- sign-in
# Both are written by `npm run setup`. Don't edit by hand.
HANDOFF_PASSWORD_HASH=
# Base32 secret for authenticator-app 2FA. Empty = 2FA off (not recommended with a tunnel).
HANDOFF_TOTP_SECRET=
# How long a sign-in lasts: hours of inactivity / maximum days.
HANDOFF_LOGIN_IDLE_HOURS=24
HANDOFF_LOGIN_MAX_DAYS=7

# ---------------------------------------------------------------- server
HANDOFF_PORT=7860
# Keep 127.0.0.1: the tunnel is the only way in from outside.
HANDOFF_HOST=127.0.0.1
# Runtime files (sign-in sessions, audit log, server log, current tunnel URL).
HANDOFF_DATA_DIR=./data

# ---------------------------------------------------------------- public access (tunnel)
# none        local only (http://127.0.0.1:7860)
# quick       Cloudflare quick tunnel: free, no account, random https://<words>.trycloudflare.com
#             address that changes on every restart (see data/public-url.txt)
# cloudflare  permanent address on your own domain (run `npm run setup:domain`)
# ngrok       ngrok tunnel (run `ngrok config add-authtoken <token>` once)
HANDOFF_TUNNEL=quick
# For HANDOFF_TUNNEL=cloudflare. Both are filled in by `npm run setup:domain`.
HANDOFF_PUBLIC_HOSTNAME=
HANDOFF_CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- Claude Code
# Where Claude Code keeps its sessions. Default: ~/.claude
HANDOFF_CLAUDE_HOME=
# Path to the claude CLI. Default: found on PATH.
HANDOFF_CLAUDE_PATH=
# Optional long-lived token from `claude setup-token`, used only for sessions Handoff starts.
# Leave empty to use your normal Claude Code login.
CLAUDE_CODE_OAUTH_TOKEN=
# Mode for sessions started from the phone: manual (ask before each tool), acceptEdits, plan, auto, dontAsk
HANDOFF_DEFAULT_MODE=manual
# Allow "bypassPermissions" (no approvals at all) from the phone. Keep false unless you're sure.
HANDOFF_ALLOW_BYPASS=false
# Only allow new sessions inside these folders. Separator: ; on Windows, : on macOS/Linux.
# Empty = any existing folder. Example: D:\projects;C:\Users\me\code
HANDOFF_ALLOWED_ROOTS=
# At most this many Claude processes started by Handoff at once.
HANDOFF_MAX_RUNS=3
# Stop an idle Claude process Handoff started after this many minutes (it resumes on the next message).
HANDOFF_IDLE_KILL_MINUTES=15
# Auto-deny a tool approval nobody answered after this many minutes.
HANDOFF_PERMISSION_TIMEOUT_MINUTES=30

# ---------------------------------------------------------------- WhatsApp (optional)
# Filled in by `npm run setup:whatsapp -- --to +<number>`. See docs/whatsapp.md.
HANDOFF_WHATSAPP_ENABLED=false
# Number that RECEIVES the messages, with country code (digits only is fine).
HANDOFF_WHATSAPP_TO=
# Shared secret between Handoff and the sender container (random, 24+ characters).
HANDOFF_WHATSAPP_TOKEN=
# Port the sender container is published on (this machine only; see docker-compose.yml).
HANDOFF_WHATSAPP_PORT=7870
# Full address of the sender, only if it runs somewhere else. Default: http://127.0.0.1:<port above>
HANDOFF_WHATSAPP_URL=
# Which events to send (comma-separated). Empty = all: approval,question,waiting,done,error
HANDOFF_WHATSAPP_EVENTS=
